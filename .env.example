# Copy to .env and fill in. .env is gitignored.

# OpenAI (default for image-gen and research/web-search)
# - Image model: gpt-image-2 (override with OPENAI_IMAGE_MODEL)
# - Research model: gpt-4.1 with web_search tool (override with OPENAI_RESEARCH_MODEL)
OPENAI_API_KEY=sk-...

# Anthropic (alternative research provider — uses Claude's web_search tool)
ANTHROPIC_API_KEY=

# Replicate (cheaper alternative for image gen — Flux Schnell ~$0.003/image)
REPLICATE_API_TOKEN=

# Brave Search (legacy: only needed for the manual image-search panel.
# Research mode uses OpenAI/Claude web_search and does NOT need this key.)
BRAVE_SEARCH_API_KEY=

# Server config
PORT=8787

