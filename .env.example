# Copy to .env and fill in. .env is gitignored.

# OpenAI (default image-gen provider, model: gpt-image-2)
OPENAI_API_KEY=sk-...

# Replicate (cheaper alternative — Flux Schnell ~$0.003/image)
REPLICATE_API_TOKEN=

# Brave Search (optional, for the web-search reference panel)
BRAVE_SEARCH_API_KEY=

# Server config
PORT=8787
